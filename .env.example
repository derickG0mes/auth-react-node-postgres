# Usuário e senha do Postgres (usados também pelo docker-compose)
DB_USER=seu_usuario
DB_PASSWORD='sua_senha'
DB_NAME=nome_do_banco

# Conexão da aplicação Node com o banco
DB_HOST=127.0.0.1
DB_PORT=5433

# Conexão em string com o Prisma com Postgres SQL
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:PORT/nome_do_db?schema=public"