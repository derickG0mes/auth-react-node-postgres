generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id         Int      @id @default(autoincrement())
  nome       String
  userName   String   
  email      String   @unique
  senhaHash  String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("usuarios")
}