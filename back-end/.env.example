# Usuário e senha do Postgres (usados também pelo docker-compose)
DB_USER=seu_usuario
DB_PASSWORD='sua_senha'
DB_NAME=nome_do_banco

# Conexão da aplicação Node com o banco
DB_HOST=127.0.0.1
DB_PORT=5433
API_PORT=3000

# Origem do front-end autorizada pelo CORS
FRONTEND_ORIGIN=http://localhost:PORT

# Gere uma chave aleatória segura com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_TOKEN=cole_aqui_a_chave_aleatoria_gerada

# Envio de e-mail (opcional). Sem estas variáveis, o link de redefinição de senha
# aparece no console do servidor. Com todas preenchidas, o e-mail é enviado por SMTP.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario_smtp
# SMTP_PASS='senha_ou_senha_de_app'
# MAIL_FROM="Meu App <no-reply@exemplo.com>"

# Conexão por String do Prisma com Postgres
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:PORT/NOME-DO-BANCO-DADOS?schema=public"
